# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG MODEL_KIND=llm
ARG MODEL_ID
ARG MODEL_FILE
ARG VISION_MODEL_FILE
ARG AUDIO_MODEL_FILE
ARG VLM_MODEL_FAMILY=auto
ARG TARGET_PLATFORM=rk3576
ARG RKLLM_TOOLKIT_VERSION
ARG VLM_IMAGE_SIZE=392
ARG RKLLM_EMBED_FLASH=0

LABEL org.opencontainers.image.title="RKLLM ${MODEL_KIND} model: ${MODEL_ID}" \
      io.rkllm.model.id="${MODEL_ID}" \
      io.rkllm.model.kind="${MODEL_KIND}" \
      io.rkllm.model.file="${MODEL_FILE}" \
      io.rkllm.vision-model.file="${VISION_MODEL_FILE}" \
      io.rkllm.audio-model.file="${AUDIO_MODEL_FILE}" \
      io.rkllm.target-platform="${TARGET_PLATFORM}" \
      io.rkllm.toolkit.version="${RKLLM_TOOLKIT_VERSION}"

COPY models/.build/ /app/models/

ENV MODEL_PATH=/app/models/${MODEL_FILE} \
    MODEL_KIND=${MODEL_KIND} \
    VISION_MODEL_PATH=/app/models/${VISION_MODEL_FILE} \
    AUDIO_MODEL_FILE=${AUDIO_MODEL_FILE} \
    VLM_MODEL_FAMILY=${VLM_MODEL_FAMILY} \
    MODEL_ID=${MODEL_ID} \
    RKLLM_TOOLKIT_VERSION=${RKLLM_TOOLKIT_VERSION} \
    TARGET_PLATFORM=${TARGET_PLATFORM} \
    VLM_IMAGE_SIZE=${VLM_IMAGE_SIZE} \
    RKLLM_EMBED_FLASH=${RKLLM_EMBED_FLASH}

CMD ["serve"]
